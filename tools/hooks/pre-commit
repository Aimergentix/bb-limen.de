#!/bin/sh
# Prüft den Arbeitsbaum, ohne Quellen, dist/ oder Git-Index zu verändern.
# Bei teilweise vorgemerkten Änderungen prüft die CI zusätzlich den Commit.
set -eu
cd "$(git rev-parse --show-toplevel)"
# QR-Codes gegen die JSON-Quellen prüfen, wenn die Dokument-Umgebung
# eingerichtet ist; --check schreibt nichts und meldet nur Veraltung.
if [ -x .venv-documents/bin/python ]; then
  .venv-documents/bin/python tools/generate_qrcodes.py --check
else
  echo "Hinweis: .venv-documents fehlt; QR-Codes nicht geprüft (siehe README)." >&2
fi
exec tools/pruefen.sh
